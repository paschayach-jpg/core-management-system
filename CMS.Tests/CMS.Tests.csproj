<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <PackageReference Include="FsCheck" Version="2.16.6" />
    <PackageReference Include="FsCheck.NUnit" Version="2.16.6" />
  </ItemGroup>

  <!-- Include source files directly to avoid old-style csproj cross-targeting issues -->
  <ItemGroup>
    <!-- Domain models and enums -->
    <Compile Include="..\CMS.Domain\Enums\*.cs" />
    <Compile Include="..\CMS.Domain\Models\*.cs" />

    <!-- Data interfaces and models -->
    <Compile Include="..\CMS.Data\Interfaces\*.cs" />
    <Compile Include="..\CMS.Data\Models\*.cs" />

    <!-- Infrastructure interfaces and ClamAVResult model -->
    <Compile Include="..\CMS.Infrastructure\Interfaces\ILoggingService.cs" />
    <Compile Include="..\CMS.Infrastructure\Interfaces\IConfigManager.cs" />
    <Compile Include="..\CMS.Infrastructure\Interfaces\INetworkDriveHelper.cs" />
    <Compile Include="..\CMS.Infrastructure\Interfaces\IClamAVAdapter.cs" />
    <Compile Include="..\CMS.Infrastructure\ClamAVResult.cs" />

    <!-- Services -->
    <Compile Include="..\CMS.Services\Interfaces\*.cs" />
    <Compile Include="..\CMS.Services\DTOs\*.cs" />
    <Compile Include="..\CMS.Services\AuditService.cs" />
    <Compile Include="..\CMS.Services\FileService.cs" />
    <Compile Include="..\CMS.Services\FolderService.cs" />
    <Compile Include="..\CMS.Services\OrgStructureService.cs" />
    <Compile Include="..\CMS.Services\PermissionService.cs" />
    <Compile Include="..\CMS.Services\UploadCheckpointService.cs" />
    <Compile Include="..\CMS.Services\VirusScanService.cs" />
  </ItemGroup>

</Project>
