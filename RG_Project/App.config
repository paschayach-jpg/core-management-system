    <add key="login" value="http://150.1.8.29:7633/api/Auth" />
    <add key="DataSourceType" value="db" />
    <add key="code_project" value="PJ001" />
    <add key="ClientSettingsProvider.ServiceUri" value="" />

    <!-- ===== เพิ่มใหม่: รองรับ CMS.Infrastructure.ConfigManager (Get<string>(key)) ===== -->
    <!-- ค่าจาก DBConfig.json เดียวกับที่ ConectionDB ใช้ (environment: dev) -->
    <add key="ProjectDbConnectionString" value="Server=192.168.250.153,2023;Database=BUI_RG;User Id=k2pack;Password=P@ssw0rd;" />
    <add key="BisDbConnectionString" value="Data Source=BISDEV;Initial Catalog=BISDB;User ID=k2pack;Password=P@ssw0rd" />
    <add key="CommonDbConnectionString" value="Data Source=BISDEV;Initial Catalog=BUI_COMMON;User ID=k2pack;Password=P@ssw0rd" />
    <add key="CmsLinkDbConnectionString" value="Data Source=BISDEV;Initial Catalog=CMS_DB;User ID=k2pack;Password=P@ssw0rd" />
    <!-- Connection string ของ CMS เอง (ใช้โดย CMS.Data.Repositories.UserAccountRepository ใน Phase F) -->
    <add key="ConnectionString" value="Data Source=192.168.250.101;Initial Catalog=CMS_DB;User ID=K2pack;Password=P@ssw0rd;" />

    <!-- ===== เพิ่มใหม่: รองรับ CMS.Services.AdAuthService (แทน RG_Project.Login.LoginManager) ===== -->
    <!-- ค่าคัดลอกมาจาก key "login" เดิมที่ LoginManager ใช้ — ต้องยืนยันว่าเป็น endpoint เดียวกันจริงก่อน deploy -->
    <add key="AdAuthApiBaseUrl" value="http://150.1.8.29:7633/api/Auth" />
    <add key="AdAuthLoginPath" value="/login" />
    <add key="AdAuthValidatePath" value="/validate-token" />
  </appSettings>
  <system.web>
    <membership defaultProvider="ClientAuthenticationMembershipProvider">
      <providers>
        <add name="ClientAuthenticationMembershipProvider" type="System.Web.ClientServices.Providers.ClientFormsAuthenticationMembershipProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" />
      </providers>
    </membership>
    <roleManager defaultProvider="ClientRoleProvider" enabled="true">
      <providers>
        <add name="ClientRoleProvider" type="System.Web.ClientServices.Providers.ClientRoleProvider, System.Web.Extensions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35" serviceUri="" cacheTimeout="86400" />
      </providers>
