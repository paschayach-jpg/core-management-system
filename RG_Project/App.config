    <add key="DBServer" value="dev" />
    <add key="EFServer" value="dev" />
    <add key="BISServer" value="dev" />
    <add key="bisRGServer" value="dev" />
    <add key="CMServer" value="dev" />
    <add key="R2Server" value="dev" />
    <add key="CMSServer" value="dev" />
    <add key="MenuControl" value="sit" />
