<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
	</configSections>
	<connectionStrings>
		<!-- SCS Database on K2dev server (SQL Server Authentication) -->
		<add name="CmsDb" connectionString="Data Source=192.168.250.101;Initial Catalog=CMS_DB;User ID=K2pack;Password=P@ssw0rd;"/>
	</connectionStrings>
	<appSettings>
		<!-- Fallback: connection string key used by ConfigManager.Get<string>("ConnectionString") -->
		<!--<add key="ConnectionString" value="Data Source=192.168.250.153,2023;Initial Catalog=SCS;User ID=K2pack;Password=P@ssw0rd;MultipleActiveResultSets=False;Connect Timeout=30;"/>-->
		<add key="ConnectionString" value="Data Source=192.168.250.101;Initial Catalog=CMS_DB;User ID=K2pack;Password=P@ssw0rd;"/>

		<!-- Notification Settings -->
		<add key="NotificationServerUrl" value="https://150.1.8.29:7157" />
		<add key="NotificationAppCode" value="CMS" />
		<add key="NotificationApiKey" value="cm_D85C684D-CE02-4E3D-8073-6A71D718D823" />

		<!-- Storage: base path for all uploaded files (NetworkDriveHelper uses this key) -->
		<add key="NetworkDrivePath" value="\\150.1.8.23\AppForUser\Cmd_LmportFile"/>

		<!-- Optional: pre-connect SMB session to avoid Windows credential popup -->
		<add key="NetworkShareCredentialEnabled" value="true"/>
		<!-- Optional: explicit target root, e.g. \\server\share (if empty uses NetworkDrivePath root) -->
		<add key="NetworkShareTarget" value="\\150.1.8.23\AppForUser"/>
		<add key="NetworkShareUser" value="pitakpong"/>
		<add key="NetworkShareDomain" value="bui_domain1"/>
		<!-- Use only one of these password keys: -->
		<add key="NetworkSharePassword" value="P@takpong0132"/>
		<add key="NetworkSharePasswordProtected" value=""/>

		<!-- Employee API -->
		<!--<add key="EmployeeApiBaseUrl" value="http://150.1.8.28:13001/api"/>-->
		<add key="EmployeeApiBaseUrl" value="http://150.1.8.29:7633/api"/>
		<add key="EmployeeApiToken" value=""/>

		<!-- AD Authentication API -->
		<add key="AdAuthApiBaseUrl" value="http://150.1.8.29:7633/"/>
		<add key="AdAuthLoginPath" value="/api/Auth/login"/>
		<add key="AdAuthValidatePath" value="/api/Auth/Validate"/>

		<!-- Menu API (userinforequest) -->
		<add key="MenuApiUrl" value="http://150.1.8.29:9070/api/userinforequest"/>
		<add key="MenuApiProgramId" value="1018"/>

		<!-- Menu actions: built-in keys come from code, extra module keys can be appended here -->
		<add key="MenuActionKeys" value=""/>
		<!-- Optional per-module keys: MenuActionKeys.ModuleName -->
		<add key="MenuActionKeys.ImportFile" value=""/>
		<add key="MenuActionKeys.KMS" value=""/>
		<add key="MenuActionKeys.PDPA" value=""/>
		<!-- Alias format: alias=TargetActionKey; alias2=AnotherActionKey -->
		<add key="MenuActionKeyAliases" value="KMS=KnowledgeBaseForm;KB=KnowledgeBaseForm;KnowledgeBase=KnowledgeBaseForm"/>
		<!-- Optional per-module aliases: MenuActionKeyAliases.ModuleName -->
		<add key="MenuActionKeyAliases.ImportFile" value=""/>
		<add key="MenuActionKeyAliases.KMS" value="knowledge_base=KnowledgeBaseForm;knowledgebase=KnowledgeBaseForm"/>
		<add key="MenuActionKeyAliases.KBC" value="knowledge_category=KBCategoryForm;kb_category=KBCategoryForm;kbcategory=KBCategoryForm"/>

		<!-- Workflow Engine Configuration (MOD-008) -->
		<!-- SLA Configuration -->
		<add key="WorkflowSLADefaultHours" value="24"/>
		<add key="WorkflowSLAWarningThresholdPercent" value="75"/>
		<!-- Background Job Configuration -->
		<add key="WorkflowSLAJobIntervalMinutes" value="5"/>
		<!-- Notification Preferences -->
		<add key="WorkflowNotificationEnabled" value="true"/>
		<add key="WorkflowNotificationEmailEnabled" value="true"/>
		<add key="WorkflowNotificationInAppEnabled" value="true"/>
		<!-- Escalation Configuration -->
		<add key="WorkflowEscalationEnabled" value="true"/>
		<add key="WorkflowAutoRejectOnOverdue" value="false"/>
	</appSettings>
	<log4net>
		<!-- Workflow Engine Logger -->
		<logger name="CMS.Services.WorkflowService" additivity="false">
			<level value="INFO"/>
			<appender-ref ref="WorkflowFileAppender"/>
			<appender-ref ref="ConsoleAppender"/>
		</logger>
		<logger name="CMS.Services.SLACalculator" additivity="false">
			<level value="INFO"/>
			<appender-ref ref="WorkflowFileAppender"/>
			<appender-ref ref="ConsoleAppender"/>
		</logger>
		<logger name="CMS.Services.BackgroundJobs.WFESLABackgroundJob" additivity="false">
			<level value="INFO"/>
			<appender-ref ref="WorkflowFileAppender"/>
			<appender-ref ref="ConsoleAppender"/>
		</logger>
		<logger name="CMS.Services.WorkflowNotificationService" additivity="false">
			<level value="INFO"/>
			<appender-ref ref="WorkflowFileAppender"/>
			<appender-ref ref="ConsoleAppender"/>
		</logger>
		<logger name="CMS.Services.WorkflowDelegationService" additivity="false">
			<level value="INFO"/>
			<appender-ref ref="WorkflowFileAppender"/>
			<appender-ref ref="ConsoleAppender"/>
		</logger>

		<!-- File Appender for Workflow Logs -->
		<appender name="WorkflowFileAppender" type="log4net.Appenders.RollingFileAppender">
			<file value="Logs/Workflow.log"/>
			<appendToFile value="true"/>
			<rollingStyle value="Date"/>
			<datePattern value="yyyy-MM-dd"/>
			<maxSizeRollBackups value="30"/>
			<maximumFileSize value="10MB"/>
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger - %message%newline"/>
			</layout>
		</appender>

		<!-- Console Appender -->
		<appender name="ConsoleAppender" type="log4net.Appenders.ConsoleAppender">
			<layout type="log4net.Layout.PatternLayout">
				<conversionPattern value="%date{HH:mm:ss} [%-5level] %logger - %message%newline"/>
			</layout>
		</appender>

		<!-- Root Logger -->
		<root>
			<level value="INFO"/>
			<appender-ref ref="ConsoleAppender"/>
		</root>
	</log4net>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="System.Memory" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.0.1.2" newVersion="4.0.1.2"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Buffers" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.0.3.0" newVersion="4.0.3.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Numerics.Vectors" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.1.4.0" newVersion="4.1.4.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0"/>
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Threading.Tasks.Extensions" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral"/>
				<bindingRedirect oldVersion="0.0.0.0-4.2.0.1" newVersion="4.2.0.1"/>
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/>
	</startup>
</configuration>
